  $items['admin/config/acuity-utils/acuity_text/custom/edit/%'] = [
    'title' => 'Edit Custom Replacement',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['acuity_text_formatter_edit_form', 6],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_CALLBACK,
  ];

  $items['admin/config/acuity-utils/acuity_text/custom/delete/%'] = [
    'title' => 'Delete Custom Replacement',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['acuity_text_formatter_delete_form', 6],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_CALLBACK,
  ];

  // Title assignment actions.
  $items['admin/config/acuity-utils/acuity_text/titles/add'] = [
    'title' => 'Assign Formatting to Title',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['acuity_text_formatter_assign_title_form'],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_CALLBACK,
