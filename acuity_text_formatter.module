    'page arguments' => ['acuity_text_formatter_remove_title_form', 6],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_CALLBACK,
  ];

  return $items;
}

/**
 * Implements hook_entity_presave().
 *
 * Takes the entity by value, not by reference. Backdrop invokes this hook
 * through module_invoke_all(), which passes its arguments by value and so emits
 * a PHP warning on every entity save for a by-reference implementation. Nothing
 * is lost: an object variable holds a handle, so changes made here are still
 * seen by the caller — which is exactly how the sibling hook_user_presave()
 * below has always worked.
 *
 * @param object $entity
 *   The entity being saved, altered in place.
 * @param string $type
 *   The entity type.
 */
function acuity_text_formatter_entity_presave($entity, $type) {
  if ($type !== 'user') {
    _acuity_text_formatter_process_entity_fields($entity, $type);
  }
}

/**
 * Implements hook_node_presave().
 *
 * By value for the same reason as hook_entity_presave() above.
 *
 * @param object $node
 *   The node being saved, altered in place.
 */
function acuity_text_formatter_node_presave($node) {
  _acuity_text_formatter_process_node_title($node);
}

/**
 * Implements hook_user_presave().
 *
 * Processes user fields early enough for modules that derive usernames from
 * user-entered profile fields.
 *
 * @param object $account
 *   The user account object.
 */
function acuity_text_formatter_user_presave($account) {
  _acuity_text_formatter_process_entity_fields($account, 'user');
  _acuity_text_formatter_process_user_name($account);
}

/**
 * Processes configured Field API text fields for any fieldable entity.
 */
function _acuity_text_formatter_process_entity_fields(&$entity, string $entity_type): void {
  if (!is_object($entity)) {
    return;
  }

  try {
    list(, , $bundle) = entity_extract_ids($entity_type, $entity);
  }
  catch (Exception $e) {
    watchdog('acuity_text_formatter', 'Unable to extract entity IDs for entity type %type: %message', [
      '%type' => $entity_type,
      '%message' => $e->getMessage(),
    ], WATCHDOG_WARNING);
    return;
  }

  if (empty($bundle)) {
    $bundle = $entity_type;
  }

  $instances = field_info_instances($entity_type, $bundle);
  if (empty($instances)) {
    return;
  }

  foreach ($instances as $field_name => $instance) {
    $field = field_info_field($field_name);

    if (empty($field['type']) || !in_array($field['type'], ['text', 'text_long', 'text_with_summary'], TRUE)) {
      continue;
    }

    if (($instance['widget']['type'] ?? '') !== 'acuity_text_formatter_widget') {
      continue;
    }

    $settings = $instance['widget']['settings']['acuity_formatter_settings'] ?? [];
    $trim = !empty($settings['trim']);
    $case_transform = $settings['case_transform'] ?? 'none';
    $collapse_spaces = !empty($settings['collapse_spaces']);

    if (!$trim && !$collapse_spaces && $case_transform === 'none') {
      continue;
    }

    if (empty($entity->{$field_name}) || !is_array($entity->{$field_name})) {
      continue;
    }

    foreach ($entity->{$field_name} as &$items) {
      if (!is_array($items)) {
        continue;
      }

      foreach ($items as &$item) {
        if (isset($item['value']) && is_string($item['value'])) {
          $item['value'] = _acuity_text_formatter_apply_rules($item['value'], $trim, $case_transform, $collapse_spaces);
        }

        if (isset($item['summary']) && is_string($item['summary'])) {
          $item['summary'] = _acuity_text_formatter_apply_rules($item['summary'], $trim, $case_transform, $collapse_spaces);
        }
      }
    }
  }
}

/**
 * Processes node title formatting.
 */
function _acuity_text_formatter_process_node_title($node): void {
  if (empty($node->type) || !isset($node->title) || !is_string($node->title)) {
    return;
  }

  $title_config = config('acuity_text_formatter.titles');
  $assignments = $title_config->get('assignments') ?: [];

  if (empty($assignments[$node->type])) {
    return;
  }

  $rules = $assignments[$node->type];

  $node->title = _acuity_text_formatter_apply_rules(
    $node->title,
    !empty($rules['trim']),
    $rules['case_transform'] ?? 'none',
    !empty($rules['collapse_spaces'])
  );
}

/**
 * Processes user account name formatting.
 *
 * @param object $account
 *   The user account object.
 */
function _acuity_text_formatter_process_user_name(object $account): void {
  if (empty($account->name) || !is_string($account->name)) {
    return;
  }

  $user_config = config('acuity_text_formatter.users');
  $rules = $user_config->get('name') ?: [];

  if (empty($rules)) {
    return;
  }

  $account->name = _acuity_text_formatter_apply_rules(
    $account->name,
    !empty($rules['trim']),
    $rules['case_transform'] ?? 'none',
    !empty($rules['collapse_spaces'])
  );
}

/**
 * Applies trim and case rules.
 */
function _acuity_text_formatter_apply_rules(string $text, bool $trim, string $case_transform, bool $collapse_spaces = FALSE): string {
  if ($trim) {
    $text = trim($text);
  }

  if ($collapse_spaces) {
    $text = preg_replace('/\s{2,}/', ' ', $text);
  }

  return match ($case_transform) {
    'lowercase' => strtolower($text),
    'uppercase' => strtoupper($text),
    'camelcase' => _acuity_text_formatter_apply_casing($text, FALSE),
    'intercapped' => _acuity_text_formatter_apply_casing($text, TRUE),
    default => $text,
  };
}

/**
 * Applies casing rules.
 */
function _acuity_text_formatter_apply_casing(string $text, bool $full_intercap = TRUE): string {
  $config = config('acuity_text_formatter.settings');

  $text = ucwords(strtolower(trim($text)));
  $text .= '   ';

  if ($config->get('capitalize_after_hyphen')) {
    $text = preg_replace_callback('/-(\w)/', function ($matches) {
      return '-' . strtoupper($matches[1]);
    }, $text);
  }

  if ($config->get('capitalize_after_apostrophe')) {
    $text = preg_replace_callback("/'([^s ])/", function ($matches) {
      return "'" . strtoupper($matches[1]);
    }, $text);
  }

  if ($config->get('capitalize_after_brackets')) {
    $text = preg_replace_callback('/\((\w)/', function ($matches) {
      return '(' . strtoupper($matches[1]);
    }, $text);
  }

  if ($config->get('capitalize_after_period')) {
    $text = preg_replace_callback('/\.(\s*)(\w)/', function ($matches) {
      return '.' . $matches[1] . strtoupper($matches[2]);
    }, $text);
  }

  if ($config->get('capitalize_after_newline')) {
    $text = preg_replace_callback('/(\r\n|\r|\n)(\s*)(\w)/', function ($matches) {
      return $matches[1] . $matches[2] . strtoupper($matches[3]);
    }, $text);
  }

  if ($full_intercap && $config->get('capitalize_mc')) {
    $text = preg_replace_callback('/\b(Mc|Mac)(?!hin|h\b|ro|re)([a-z])/', function ($matches) {
      return $matches[1] . strtoupper($matches[2]);
    }, $text);
  }

  $text = _acuity_text_formatter_apply_custom_replacements($text);

  return rtrim($text);
}

/**
 * Applies custom whole-word replacements.
 */
function _acuity_text_formatter_apply_custom_replacements(string $text): string {
  $config = config('acuity_text_formatter.settings');
  $replacements = $config->get('custom_replacements') ?: [];

  foreach ($replacements as $entry) {
    if (empty($entry['search']) || !isset($entry['replace'])) {
      continue;
    }

    $pattern = '/(?<![A-Za-z0-9])' . preg_quote($entry['search'], '/') . '(?![A-Za-z0-9])/i';
    $text = preg_replace($pattern, $entry['replace'], $text);
  }

  return $text;
}

/**
 * Implements hook_form_FORM_ID_alter() for field_ui_field_edit_form.
 */
function acuity_text_formatter_form_field_ui_field_edit_form_alter(&$form, &$form_state) {
  if (isset($form['#instance']) && $form['#instance']['widget']['type'] === 'acuity_text_formatter_widget') {
    if (isset($form['instance']['settings']['text_processing'])) {
      $form['instance']['settings']['text_processing']['#type'] = 'value';
      $form['instance']['settings']['text_processing']['#value'] = 0;

      $form['instance']['settings']['acuity_processing_note'] = [
        '#type' => 'item',
        '#title' => t('Text processing'),
        '#markup' => t('<em>Forced to <strong>Plain text</strong> because the Acuity Text Formatter is enabled. Rich text (WYSIWYG) is incompatible with case formatting.</em>'),
        '#weight' => $form['instance']['settings']['text_processing']['#weight'] ?? 0,
      ];
    }

    if (isset($form['instance']['settings']['allowed_formats'])) {
      $form['instance']['settings']['allowed_formats']['#access'] = FALSE;
    }

    if (isset($form['instance']['settings']['better_formats'])) {
      $form['instance']['settings']['better_formats']['#access'] = FALSE;
    }
  }
}
