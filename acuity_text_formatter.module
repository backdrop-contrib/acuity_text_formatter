  $items['admin/config/acuity-utils/acuity_text/global'] = [
    'title' => 'Global',
    'type' => MENU_DEFAULT_LOCAL_TASK,
    'weight' => 0,
  ];

  $items['admin/config/acuity-utils/acuity_text/titles'] = [
    'title' => 'Titles',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['acuity_text_formatter_titles_form'],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_LOCAL_TASK,
    'weight' => 10,
  ];

  $items['admin/config/acuity-utils/acuity_text/users'] = [
    'title' => 'Users',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['acuity_text_formatter_users_form'],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_LOCAL_TASK,
    'weight' => 20,
  ];

  $items['admin/config/acuity-utils/acuity_text/custom'] = [
    'title' => 'Custom replacements',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['acuity_text_formatter_custom_replacements_form'],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_LOCAL_TASK,
    'weight' => 30,
  ];

  // Custom replacement actions.
  $items['admin/config/acuity-utils/acuity_text/custom/add'] = [
    'title' => 'Add Custom Replacement',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['acuity_text_formatter_edit_form'],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_CALLBACK,
